# 复制为项目根目录 .env 后填写。不要提交真实密钥。
# 本文件由 python-dotenv 读取，不要作为 shell 脚本执行。
# 含空格、# 等字符的值请用引号包裹；不进行 ${变量} 插值。

# 数据库绝对路径或相对项目根目录的路径。
# 原件、打印文件、事件、日志及 session.key 均存放在数据库同目录。
DATABASE_PATH=data/app.db

# 首次部署先设为 false；配置好权限并准备接收真实消息时再改为 true。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 阿里云 OCR：RecognizeInvoice，版本 2021-07-07。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# 首个管理员：两项都填写，密码至少 8 位。仅首次创建，不覆盖已有管理员。
# 两项都留空则不创建；同名普通账号存在时拒绝自动提升权限。
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# 本机 HTTP 为 false；浏览器通过 HTTPS 访问时设为 true。
COOKIE_SECURE=false
